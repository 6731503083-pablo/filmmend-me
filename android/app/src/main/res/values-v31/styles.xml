<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ explicit splash configuration to avoid system gray fallback -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#0A0E21</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0A0E21</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#0A0E21</item>
    </style>
</resources>
